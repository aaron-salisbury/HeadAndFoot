<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <!-- Runs on the .NET Framework 2.0 runtime where installed (Windows 98 and later), and on the 4.x runtime built into modern Windows. -->
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
