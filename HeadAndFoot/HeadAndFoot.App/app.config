<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="HeadAndFoot.App.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <userSettings>
        <HeadAndFoot.App.Properties.Settings>
            <setting name="ApplicationFriendlyName" serializeAs="String">
                <value>Head &amp; Foot</value>
            </setting>
            <setting name="AboutDescription" serializeAs="String">
                <value>Play the family favorite card game Head &amp;&amp; Foot.</value>
            </setting>
            <setting name="ApplicationLink" serializeAs="String">
